{
  "name": "WorkingHours",
  "type": "object",
  "properties": {
    "day_of_week": {
      "type": "number",
      "minimum": 0,
      "maximum": 6,
      "description": "0=Sunday ... 6=Saturday"
    },
    "start_time": {
      "type": "string",
      "description": "HH:mm"
    },
    "end_time": {
      "type": "string",
      "description": "HH:mm"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "day_of_week",
    "start_time",
    "end_time"
  ]
}