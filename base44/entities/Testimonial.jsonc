{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5,
      "minimum": 1,
      "maximum": 5
    },
    "text_fa": {
      "type": "string"
    },
    "text_en": {
      "type": "string"
    },
    "text_ar": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date"
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "display_name"
  ]
}