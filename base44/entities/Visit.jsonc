{
  "name": "Visit",
  "type": "object",
  "properties": {
    "visit_id": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "doctor_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "visit_date": {
      "type": "string",
      "format": "date"
    },
    "chief_complaint": {
      "type": "string"
    },
    "symptoms": {
      "type": "string"
    },
    "diagnosis": {
      "type": "string"
    },
    "examination_findings": {
      "type": "string"
    },
    "clinical_notes": {
      "type": "string"
    },
    "treatment_plan": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "visible_to_patient": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "patient_id",
    "visit_date"
  ]
}